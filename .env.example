SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Smarticket tenant configuration is no longer env-driven. The list
# of feeds we scrape (mbe-rg.smarticket.co.il + ramat-gan.smarticket.co.il
# as of 2026-05) lives in lib/sourceUrls.js as a hardcoded TENANTS
# table. Adding a third feed = editing that file. The legacy
# SMARTICKET_BASE_URL var is no longer read by anything; safe to
# delete from your local .env.

WHATSAPP_PHONE=your-phone-number
WHATSAPP_KEY=your-callmebot-api-key
WHATSAPP_VERIFY_TOKEN=event-scout-verify
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
TELEGRAM_TOKEN=your-telegram-bot-token
# Bot operator's chat id. Used by bot/telegramBot.js to gate
# admin-only commands (e.g. /scrape, /resolve). NOT used for
# broadcast notifications anymore — those flow per-user through
# saved searches and watchers.
TELEGRAM_CHAT_ID=your-telegram-chat-id
GEMINI_API_KEY=your-google-gemini-api-key
WA_WATCH_GROUPS=group1-id@g.us,group2-id@g.us

# Optional: Google Places API for resolving venue names (e.g. "משחקיית רגעים")
# to verified addresses. Without it, geocoding falls back to Nominatim+Gemini.
GOOGLE_PLACES_API_KEY=

# Default city appended to ambiguous geocoder queries — keeps Google /
# Nominatim / our LLM normalizer from confidently picking a venue in a
# neighbouring city ("מרכז קהילתי אורות" → "אורים 41, ת"א" was the
# motivating bug). Stored as the SQL default on locations.city; change
# this and the SQL default together if you ever shift markets.
# DEFAULT_GEOCODE_CITY=רמת גן

# Optional: LangSmith / LangChain tracing API key. When set, agent runs
# stream traces to your LangSmith project for inspection. Get one at
# https://smith.langchain.com → Settings → API Keys.
LANGCHAIN_API_KEY=

# Optional: Sentry DSN for error monitoring. When set, every alertAdmin
# call (silent UX dead-ends + thrown errors + Telegraf bot.catch) is
# forwarded to Sentry alongside the Telegram admin ping. See
# lib/sentry.js for behaviour. Get a DSN at https://sentry.io →
# Settings → Projects → <your project> → Client Keys (DSN).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production       # default: NODE_ENV or "development"
# SENTRY_RELEASE=event-scout@1.0.0    # optional, helps tag issues per deploy
# SENTRY_TRACES_SAMPLE_RATE=0.1       # default 0.1; bump locally when debugging
# LangSmith region — keys created on the EU host fail with 403 against
# the default US endpoint. Override here when your account is EU-based.
# LANGCHAIN_ENDPOINT=https://eu.api.smith.langchain.com
# LANGCHAIN_PROJECT=event-scout

# Optional: bounding box that restricts Google Places results to the
# geographic scope of your event sources. Default covers Tel Aviv metro,
# matching Smarticket Ramat Gan. Override (or remove the rectangle in
# code) when adding sources from other regions.
# PLACES_BBOX_SOUTH=31.97
# PLACES_BBOX_NORTH=32.16
# PLACES_BBOX_WEST=34.74
# PLACES_BBOX_EAST=34.92

# Optional: Scrape scheduling. The bot fires the Smarticket scraper on a
# jittered timer (random delay in [MIN, MAX] seconds) and pauses between
# ACTIVE_END_HOUR and ACTIVE_START_HOUR Asia/Jerusalem time.
# SCRAPE_MIN_INTERVAL_S=60
# SCRAPE_MAX_INTERVAL_S=300
# SCRAPE_ACTIVE_START_HOUR=8
# SCRAPE_ACTIVE_END_HOUR=22
