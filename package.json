{
  "name": "event-scout",
  "version": "1.0.0",
  "description": "Event tracker that monitors Smarticket events and syncs with Supabase",
  "main": "bot/telegramBot.js",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "node bot/telegramBot.js",
    "check": "node api/check.js",
    "enrich": "node api/enrich.js",
    "bot": "node bot/telegramBot.js",
    "match": "node bot/matchRunner.js",
    "scraper": "node scraper/whatsappScraper.js",
    "expire": "node jobs/expireTickets.js",
    "flush": "node jobs/flushNotifications.js",
    "warm-locations": "node jobs/warmLocations.js",
    "backfill-labels": "node jobs/backfillLabels.js",
    "backfill-enrichment-retry": "node jobs/backfillEnrichmentRetry.js",
    "backfill-locations": "node jobs/backfillLocations.js all",
    "city-api-inspect": "node jobs/cityApiInspect.js",
    "city-api-scrape": "node lib/cityApiScraper.js",
    "city-api-scrape-dry": "node lib/cityApiScraper.js --dry-run"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.52.0",
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "langsmith": "^0.6.1",
    "luxon": "^3.7.2",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3",
    "whatsapp-web.js": "^1.34.7"
  }
}
